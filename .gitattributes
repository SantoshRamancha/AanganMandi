# Line endings: the repository stores LF, and every checkout uses LF too, whatever core.autocrlf says, so
# tools on Windows and Linux see the same files (no CRLF/LF mix in the working copy).
* text=auto eol=lf

# Windows-only files keep CRLF.
*.sln   text eol=crlf
*.bat   text eol=crlf
*.cmd   text eol=crlf
*.ps1   text eol=crlf

# Binary files are never converted.
*.png   binary
*.jpg   binary
*.jpeg  binary
*.webp  binary
*.gif   binary
*.ico   binary
*.pdf   binary
*.dll   binary
*.exe   binary
*.jar   binary
*.keystore binary
*.jks   binary
*.ttf   binary
*.otf   binary
*.woff  binary
*.woff2 binary
