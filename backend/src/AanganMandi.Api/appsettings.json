{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "AllowedHosts": "*",
  // Kinichit.Communication. "Log" only writes emails to the log; production uses "Smtp" or "SendGrid" with the
  // password / API key in user-secrets or appsettings.Production.json (never committed). See backend/lib/README.md.
  "Email": {
    "Provider": "Log",
    "FromAddress": "no-reply@aanganmandi.in",
    "FromName": "Aangan Mandi"
  },
  "Sms": {
    "Provider": "Log",
    "DefaultCountryCode": "91"
  },
  // Emails are queued in this app's database (dbo.EmailQueueItems, created on first use) and sent by a Hangfire job.
  "EmailQueue": {
    "ConnectionStringName": "Default"
  },
  // Link for the "Open Aangan Mandi" button in emails; no button when empty.
  "Notifications": {
    "AppUrl": ""
  },
  // Uploaded files (KYC proofs, space photos). "Object" keeps them in the product's bucket through StorageProvider
  // (backend/lib/StorageProvider); "Local" on disk under Storage:Root. KeyPrefix puts every file in a folder of the
  // bucket ("dev" locally) so environments never mix.
  "Storage": {
    "Provider": "Object",
    "KeyPrefix": "prod"
  },
  // Never put AccessKey / SecretKey here: user-secrets locally, environment variables (StorageProvider__SecretKey) on servers.
  "StorageProvider": {
    "ServiceUrl": "https://in-south1-objectstore.e2enetworks.net",
    "BucketName": "",
    "AccessKey": "",
    "SecretKey": ""
  }
}
